# Google OAuth client ID for the website login (Web application type!).
# Get it in Google Cloud Console → Credentials → OAuth client ID (Web application).
# Locally: copy this file to .env — NEVER commit .env (it is gitignored).
# Vercel: Project Settings → Environment Variables → add VITE_GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Admin + databáze (Vercel → Environment Variables, po deployi):
# Neon → Connection string (pooled). Psát BEZ uvozovek.
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
# Kdo smí do /admin (čárkou oddělené e-maily, malá písmena netřeba řešit)
ADMIN_EMAILS=tomaskonarik1977@gmail.com
# Stejné Client ID jako výše — server jím ověřuje Google token (zabezpečení admina)
GOOGLE_CLIENT_ID=

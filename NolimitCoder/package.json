{
    "name":  "nolimit-coder-v2",
    "version":  "1.0.0",
    "description":  "Ultra modern Electron chat with NolimitCoder models - everything local, offline after download",
    "main":  "src/main/main.js",
    "type":  "commonjs",
    "author":  "NolimitCoder",
    "license":  "MIT",
                "scripts":  {
                    "start":  "electron .",
                    "dev":  "electron .",
                    "build":  "electron-builder",
                    "build:win":  "electron-builder --win",
                    "postinstall":  "electron-builder install-app-deps"
                },
    "devDependencies":  {
                            "electron":  "^33.2.1",
                            "electron-builder":  "^25.1.8"
                        },
    "dependencies":  {},
    "build":  {
                  "appId":  "com.nolimitcoder.clean",
                  "productName":  "NolimitCoder Clean",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "src/**/*",
                                "proxies/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "icon":  "src/renderer/assets/icon.ico",
                              "target":  ["nsis"]
                          },
                           "nsis":  {
                                "installerIcon":  "src/renderer/assets/icon.ico",
                                "oneClick":  true,
                                "runAfterFinish":  true,
                                "uninstallerIcon":  "src/renderer/assets/icon.ico",
                                "deleteAppDataOnUninstall":  false,
                                "createDesktopShortcut":  true,
                                 "artifactName":  "NolimitCoder Clean Setup ${version}.${ext}",
                                "shortcutName":  "NolimitCoder Clean",
                                "perMachine":  false,
                                 "license":  "build/license.txt",
                                 "installerSidebar":  "build/installerSidebar.bmp",
                                 "uninstallerSidebar":  "build/installerSidebar.bmp",
                                 "installerHeader":  "build/installerHeader.bmp",
                                 "allowToChangeInstallationDirectory":  false,
                                "createStartMenuShortcut":  true
                            }
              }
}